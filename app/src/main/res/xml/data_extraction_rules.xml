<?xml version="1.0" encoding="utf-8"?><!--
   Nexo data extraction rules (Android 12+).
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The encrypted Nextcloud application password must never be backed up
             or restored: the Keystore key is not exportable. -->
        <exclude domain="sharedpref" path="nexo_secure.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nexo_secure.xml"/>
    </device-transfer>
</data-extraction-rules>
