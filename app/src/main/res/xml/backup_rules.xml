<?xml version="1.0" encoding="utf-8"?><!--
   Nexo backup rules.
   This file is ignored for devices older than API 31.
-->
<full-backup-content>
    <!-- The encrypted Nextcloud application password must never be backed up or
         restored: the Keystore key is not exportable, so the ciphertext would be
         left without its key on another device. -->
    <exclude domain="sharedpref" path="nexo_secure.xml"/>
</full-backup-content>
